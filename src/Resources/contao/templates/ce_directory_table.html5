<?php $this->extend('block_unsearchable'); ?>
<?php $this->block('content'); ?>
<?php if ($this->searchEnabled): ?>
<form method="get" class="directory-search">
  <select name="<?= $this->searchFieldName ?>" aria-label="Suchfeld auswählen">
    <?php foreach ($this->searchColumns as $column): ?><option value="<?= \Contao\StringUtil::specialchars($column['key']) ?>"<?= $this->searchField === $column['key'] ? ' selected' : '' ?>><?= \Contao\StringUtil::specialchars($column['label']) ?></option><?php endforeach; ?>
  </select>
  <input type="search" aria-label="Suchbegriff" name="<?= $this->searchName ?>" value="<?= \Contao\StringUtil::specialchars($this->query) ?>">
  <button type="submit">Suchen</button>
</form>
<?php endif; ?>
<div class="directory-scroll ce_table listing" style="overflow-x:auto">
<table class="directory_table all_records">
  <thead><tr><?php foreach ($this->columns as $column): ?><th scope="col"><?= \Contao\StringUtil::specialchars($column['value']) ?></th><?php endforeach; ?><?php if ($this->detailColumns): ?><th scope="col">Details</th><?php endif; ?></tr></thead>
  <tbody><?php foreach ($this->rows as $row): ?><tr><?php foreach ($this->columns as $column): ?><td><?= $this->cellFormatter->render($column['key'], (string) ($row[$column['key']] ?? '')) ?></td><?php endforeach; ?><?php if ($this->detailColumns): ?><td><details><summary>Details anzeigen</summary><dl><?php foreach ($this->detailColumns as $column): ?><?php if (trim((string) ($row[$column['key']] ?? '')) !== ''): ?><dt><?= \Contao\StringUtil::specialchars($column['value']) ?></dt><dd><?= $this->cellFormatter->render($column['key'], (string) $row[$column['key']]) ?></dd><?php endif; ?><?php endforeach; ?></dl></details></td><?php endif; ?></tr><?php endforeach; ?></tbody>
</table>
</div>
<?php if (!$this->rows): ?><p>Keine Einträge gefunden.</p><?php endif; ?>
<?php $this->endblock(); ?>
