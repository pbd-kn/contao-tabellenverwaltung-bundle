<style>
.table-management { padding: 24px; line-height: 1.55; }
.table-management .tm-intro { margin: 0 0 24px; max-width: 72ch; }
.table-management .tm-section { margin: 0 0 24px; padding: 20px; border: 1px solid #b8bdc4; border-radius: 4px; }
.table-management .tm-section h2 { margin: 0 0 12px; padding: 0; font-size: 1.15rem; line-height: 1.4; }
.table-management p { margin: 0 0 16px; }
.table-management p:last-child { margin-bottom: 0; }
.table-management form { margin: 0; }
.table-management label { display: inline-block; margin-bottom: 6px; font-weight: 600; }
.table-management .tl_select, .table-management .tl_text { width: 100%; max-width: 34rem; box-sizing: border-box; }
.table-management input[type=file] { max-width: 100%; }
.table-management .tm-actions { margin-top: 20px; }
.table-management .tm-help { max-width: 85ch; }
.table-management .tm-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px 24px; }
.table-management .tm-table-scroll { overflow-x: auto; margin: 16px 0; }
.table-management .tm-table-scroll table { width: 100%; border-collapse: collapse; }
.table-management .tm-table-scroll th, .table-management .tm-table-scroll td { padding: 10px 12px; border-bottom: 1px solid #b8bdc4; text-align: left; vertical-align: top; min-width: 100px; }
.table-management .tm-table-scroll th { font-weight: 600; }
.table-management pre { white-space: pre-wrap; overflow-wrap: anywhere; }
@media (max-width: 600px) { .table-management { padding: 12px; } .table-management .tm-section { padding: 14px; } }
</style>
